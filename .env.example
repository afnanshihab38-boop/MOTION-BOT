# MOTION-BOT — Environment Variables Template
# Copy this file to .env.local for local overrides.
# NOTE: Do NOT commit secrets, real credentials, or production tokens to version control.

# Application Configuration
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase 7.2: LLM Provider Foundation (OpenRouter & NVIDIA Nemotron 3 Ultra)
# Server-side only (never prefix with NEXT_PUBLIC_)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MOCK_MODE=false
LLM_TIMEOUT_MS=30000

# Future Phase Integrations
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

